# Planforge developer configuration template
#
# Copy this file to `.env` and adjust values for your local installation.
# The `.env` file is ignored by Git and must never be committed.
# Every value in this file is a placeholder, not a real credential.
#
# Environment variables configure developer/deployment concerns only.
# Planner behavior is configured through the application UI.

# --- Backend ---
PLANFORGE_ENV=development

# Services bind to loopback by default. Do not change without reviewing
# the security implications of exposing the service to your network.
PLANFORGE_HOST=127.0.0.1
PLANFORGE_PORT=8000

# SQLite during development; PostgreSQL URL format supported later, e.g.
# postgresql+psycopg://USER:PASSWORD@HOST:5432/planforge
PLANFORGE_DATABASE_URL=sqlite:///./data/planforge.db

# Generate a real secret for your installation, e.g. in PowerShell:
#   py -c "import secrets; print(secrets.token_urlsafe(32))"
PLANFORGE_SECRET_KEY=replace-with-a-generated-secret
